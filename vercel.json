{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/ripping-zacks", "destination": "/", "permanent": true },
    { "source": "/ripping-zacks.html", "destination": "/", "permanent": true },
    { "source": "/collection.html", "destination": "/lorcana-vault", "permanent": true },
    { "source": "/collection", "destination": "/lorcana-vault", "permanent": true },
    { "source": "/lorcana.html", "destination": "/lorcana-vault", "permanent": true },
    { "source": "/lorcana", "destination": "/lorcana-vault", "permanent": true },
    { "source": "/boosters.html", "destination": "/sealed-vault", "permanent": true },
    { "source": "/boosters", "destination": "/sealed-vault", "permanent": true },
    { "source": "/marketing.html", "destination": "/slab-vault", "permanent": true },
    { "source": "/marketing", "destination": "/slab-vault", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/photos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
